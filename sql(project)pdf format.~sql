 --3.Bütün işçilərin adının sonuna soyadındakı simvolların sayı qədər “*”- simvolunu əlavə etmək və 
 --DistanceFromHome sütunundakı məlumatın sonuna KM əlavə edərək ekrana çıxartmaq
select rpad(emp.firstname ,length(emp.firstname)+length(emp.lastname),'*') 
as firstname_ulduz,emp.distancefromhomekm || 'KM' as distance_km from Employeee emp


--4.Ən yüksək və ən az maaş alan işçilərin təhsil səviyələrini çıxaran sorğu yazın.
select emp.firstname,emp.lastname,ed.EducationLevel,emp.salary from Employeee emp 
join Education ed on emp.Education=ed.educationlevelid
where emp.salary=(select max(emp.salary) from Employeee emp)  
or emp.Salary=(select min(emp.Salary) from Employeeee emp) 


--5.Təhsil səviyəsi artan sıra ilə olmaqla hər işçinin bir əvvəlki işçi ilə maaş fərqini tapın.
select 
    emp.firstname,
    emp.lastname,
    ed.educationlevel,
    emp.salary,
    LAG(emp.salary) OVER (PARTITION BY ed.educationlevel order by emp.salary),
    emp.salary - LAG(emp.salary) OVER (PARTITION BY ed.educationlevel order by emp.salary) as salary_difference
from employeee emp
join education ed on emp.education = ed.educationlevelid
order by ed.educationlevel, emp.salary;

--6. Əməkdaşların evdən iş yerinə ən uzaq məsafəni qət edənlərini tapın və onlarla bağlı məlumatları göstərin.
select * from Employeee emp
where emp.distancefromhomekm=(select max(emp.distancefromhomekm) from Employeee emp)


--7. Orta yaş və orta maaşdan yuxarı olan əməkdaşları tapın.
select * from Employeee emp
where emp.age>=(select avg(emp.age) from Employeee emp) and
emp.salary>=(select avg(emp.salary) from Employeee emp)


--8. Təhsil Səviyyəsinə və Təhsil Sahəsinə Görə Cinsiyyətin Paylanması
select ed.educationlevel,emp.educationfield,emp.gender,count(*)
from Employeee emp join Education ed
on emp.education=ed.educationlevelid
group by ed.educationlevel,emp.educationfield,emp.gender
order by ed.educationlevel,emp.educationfield,emp.gender


 --9. Hər təhsil səviyyəsi üçün əməkdaşların illik maaş artımını və şirkətdəki ortalama iş müddətini tapın.
select ed.educationlevel,avg(emp.salary),avg(emp.YearsAtCompany) as AvgYearsAtCompany  -------ILLIK MAAS ARTIMI????
from Employeee emp join Education ed
on emp.education=ed.educationlevelid
group by ed.educationlevel


--10. Hər bir departamentdə əməkdaşların şirkətdən çıxma nisbətini tapın (ATTRITION "Yes" olan əməkdaşlar).
select  
    emp.Department,
    count(case when emp.Attrition='Yes' then 1 end) as Quitters,
    count(*) as TotalEmployees,
    round(count(case when emp.Attrition='Yes' then 1 end)*100 / count(*)) || '%' as AttritionRate_Percent
from Employeee emp
group by emp.department
order by AttritionRate_Percent desc;



--11. Hər təhsil səviyyəsi üçün orta maaşı ötən əməkdaşların siyahısını əldə edin.
select emp.firstname, emp.lastname, emp.salary, ed.educationlevel
from employeee emp join education ed 
on emp.education = ed.educationlevelid
where emp.salary>(
    select avg(emp2.salary)
    from employeee emp2
    join education ed2 on emp2.education = ed2.educationlevelid
    where ed2.educationlevel=ed.educationlevel
)
order by ed.educationlevel, emp.salary desc;

--12. 3 ildən az təcrübəsi olan, amma şirkətdə orta maaşdan çox qazanan əməkdaşları göstərin.
select * from Employeee emp
where emp.YearsAtCompany<3
and emp.salary>(
    select avg(emp.salary)
    from Employeee emp
);

--13. Hər bir təhsil səviyyəsi və iş roluna görə əməkhaqqına görə ən yüksək 5 əməkdaşı seçin.
select 
* from (
    select 
        ed.EducationLevel,
        emp.JobRole,
        emp.FirstName,
        emp.LastName,
        emp.Salary,
        row_number() over(
            partition by ed.EducationLevel, emp.JobRole 
            order by emp.Salary desc
        ) as rn
    from Employeee emp
    join Education ed on emp.Education = ed.EducationLevelID
) sub
where rn <= 5
order by EducationLevel, JobRole, Salary desc;


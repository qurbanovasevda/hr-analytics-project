create table Education(
             EducationLevelID number primary key,
             EducationLevel varchar2(50)
);

select * from Education for update





create table Employeee(
             EmployeeID varchar2(20) primary key,
             FirstName varchar2(25),
             LastName varchar2(50),
             Gender varchar2(20),
             Age number,
             BusinessTravel varchar2(20),
             Department varchar2(25),
             DistanceFromHomeKM number,
             State varchar2(5),
             Ethnicity varchar2(50),
             Education number,
             EducationField varchar2(30),
             JobRole varchar2(50),
             MaritalStatus varchar2(10),
             Salary number,
             StockOptionLevel number,
             OverTime varchar2(5),
             HireDate date,
             Attrition varchar2(5),
             YearsAtCompany number,
             YearsInMostRecentRole number,
             YearsSinceLastPromotion number,
             YearsWithCurrManager number
);

select * from Employeee for update;


--2.Hər EducationLevel-də təhsil alan tələbələrin sayını tapmaq 
select EducationLevel, count(*) as count_of_educationlevel from Employeee emp 
join Education ed on emp.Education=ed.educationlevelid
group by EducationLevel


--3.Tələbənin adı,soyadı bir sütunda Full Name Aliası ilə çıxmalı, digər sütunlarda education Level-i,Doğum tarixi və Maaşı çıxmalıdır 
select emp.firstname || ' ' || emp.lastname as FullName,ed.educationlevel,emp.age,emp.salary from Employeee emp
join Education ed on emp.Education=ed.educationlevelid

--4.Job Role-larda işçilərə görə ən çox 3 Job Role növünü təyin etmək. Job Role və Employee Count çıxmalı 
select emp.jobrole,count(*) from Employeee emp
group by emp.jobrole
order by count(*) desc
fetch first 3 rows only


--5.Hər Departamentdəki ən yüksək maaşı və departament adını ekrana çıxartmaq 
select emp.department,max(emp.salary) as max_salary from Employeee emp
group by emp.department

--6. Hər Departamentə görə maaş ortalamasını ekrana çıxartmaq 
select emp.department,avg(emp.salary) as avg_salary from Employeee emp
group by emp.department

--7.Hər işçinin adını,maaşını və işə götürülmə tarixindən(Hire Date) bü günədək neçə aydır ki, həmin şirkətda çalışır ay sayını ekrana çıxartmaq 
select emp.firstname,emp.salary,trunc(Months_between(sysdate,emp.hiredate)) from Employeee emp

--8.Bütün işçilərin adının sonuna soyadındajı simvolların sayı qədər “*”- simvolunu əlavə etmək və  
--Distance From Home sütunundakı məlumatın sonuna KM əlavə edərək ekrana çıxartmaq 
select rpad(emp.firstname ,length(emp.firstname)+length(emp.lastname),'*') 
as firstname_ulduz,emp.distancefromhomekm || 'KM' as distance_km from Employeee emp

--9.Hər Departamentdə neçə fərqli job role-u olan işçi çalışır sayı tapmaq 
select emp.department, count(distinct(emp.jobrole)) as count_of_distinct_jrole from Employeee emp
group by emp.department

--10.Evdən olan məsafəsi maksimal olan ilk 10 işçinin siyahısını çıxartmaq :məsafə,ad,soyad,martial status ekrana çıxmalı 
select emp.distancefromhomekm,emp.firstname,emp.lastname,emp.maritalstatus from Employeee emp
order by emp.distancefromhomekm desc 
fetch first 10 rows only

--11.Employee Tablesində olan siyahının ilk 50%-ni ekrana çıxardan sorğu yazmaq 
select * from Employeee 
fetch first 50 percent rows only

--12.Employee Tablesində hər employee-ə görə pseudoColumnları tapmaq 
select rowid,rownum,sysdate,emp.*
from Employeee emp;

--13.Şirkətdə ən uzun müddətli çalışan top 10 işçinin ad soyadı və bu gündən etibarən neçə ildir burada çalışdığını tapmaq
select emp.firstname,emp.lastname,trunc(months_between(sysdate,emp.hiredate)/12) as YearsWorked from Employeee emp
order by emp.hiredate
fetch first 10 rows only

